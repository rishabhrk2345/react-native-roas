# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'RoasRnTest' do
  config = use_native_modules!

  # RoasSensor is not on the CocoaPods trunk, and a podspec cannot name a git
  # source for its own dependency — so although react-native-roas.podspec
  # declares `s.dependency 'RoasSensor'`, nothing can satisfy it without this
  # line. Without it `pod install` fails with
  #
  #   [!] Unable to find a specification for `RoasSensor`
  #
  # which reads like a broken bridge and is really a missing source.
  #
  # LIVE rather than commented out, matching roas-sensor-flutter's example
  # Podfile. It used to be commented with a machine-specific :path, which made
  # the documented first step on a Mac "edit this file before anything can
  # build" — against a path that only ever existed on one laptop.
  #
  # Pinned to a TAG, not a branch: a tag is what makes a build traceable to a
  # release, and 0.1.7 is a hard floor for bridge 0.1.5 — requestTracking,
  # updateConversionValue and appAccountToken are 0.1.7 API, and anything older
  # fails to compile with missing-member errors rather than at resolve time.
  pod 'RoasSensor', :git => 'https://github.com/rishabhrk2345/Roas-ios-SDK.git', :tag => '0.1.7'

  # For local development against a checkout of sdk-ios instead, comment the
  # line above and point this at wherever you placed it:
  #   pod 'RoasSensor', :path => '../../../roas-sensor-service/sdk-ios'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
