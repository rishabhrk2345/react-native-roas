# Copy to `.env` (gitignored) and fill in. Read at BUILD time by
# react-native-config — editing this means rebuilding, not just refreshing Metro.

# Where beacons go. 10.0.2.2 is the emulator's alias for the host's localhost
# and resolves NOWHERE else: a physical phone or a Play-installed build needs
# an HTTPS tunnel (`ngrok http 8000`) or the real host.
ROAS_BASE_URL=http://10.0.2.2:8000

# The site's public key — "ROAS RN Sample" (com.roasrntest), this app's OWN
# site, deliberately not the native sample's, so RN installs stay out of the
# other samples' retention, fraud and ROAS numbers.
ROAS_PUBLIC_KEY=e4a19382-3284-419f-a607-4203a05f69d9

# Beacon signing secret — Setup → your app → Beacon signing → "Generate".
# Empty means beacons go out unsigned, which the collector accepts until
# "reject unsigned beacons" is switched on for the site.
ROAS_APP_SECRET=
