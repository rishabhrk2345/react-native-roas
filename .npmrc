# Do NOT auto-install peer dependencies here. `react-native` is declared as a
# peer ("*") so the HOST app's copy is the one that runs — but npm 7+ installs
# peers by default, which dropped a second, newer react-native into this
# package's own node_modules. Metro's hierarchical lookup from index.js then
# found THAT copy before the app's, so the bridge and the app held two
# different `RCTDeviceEventEmitter` instances: every method call still worked
# (NativeModules proxies to one global registry either way), but every
# delivery event the native side emitted landed on the emitter nobody was
# listening to. Confirmed live on RN 0.86 — `onDeliveryResult` was silent while
# beacons arrived with 201s.
legacy-peer-deps=true
